{
  "parse-context": {
    "timeout-limits": { "progressTimeoutMillis": 60000 },
    "commons-digester-factory": {
      "digests": [ { "algorithm": "SHA256" } ],
      "skipContainerDocumentDigest": false
    }
  },
  "grpc": { "maxInboundMessageBytes": 104857600 },
  "pipes": {
    "javaPath": "JAVA_PATH",
    "numClients": 2,
    "maxInlineBytes": 1048576,
    "forkedJvmArgs": [ "-Xmx1g", "-XX:ParallelGCThreads=2" ],
    "emitStrategy": { "type": "PASSBACK_ALL" }
  },
  "plugin-roots": "PLUGIN_ROOTS"
}
